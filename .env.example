# ── Development database (ledger-db container on host port 5432) ──────────────
DATABASE_URL=postgresql://ledger:ledger_dev_secret@localhost:5432/ledger

# ── Test database (ledger-test-db container on host port 5433) ────────────────
TEST_DATABASE_URL=postgresql://ledger:ledger_dev_secret@localhost:5433/ledger_test

# ── Seed data path ────────────────────────────────────────────────────────────
# Absolute or relative path to your generated seed_events.jsonl
SEED_DATA_PATH=data/seed_events.jsonl

# ── MCP server (Phase 5) ──────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8080

# ── Projection daemon ─────────────────────────────────────────────────────────
PROJECTION_BATCH_SIZE=100
PROJECTION_POLL_INTERVAL_MS=500
